# ==============================================================================
# NIFTY Autonomous Trader — Environment Credentials
# ==============================================================================
# Copy this file to .env and configure your secret API keys.

# Primary AI Brain (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Universal Multi-Model Fallback (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Direct OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Direct Anthropic (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Direct NVIDIA NIM (Nemotron)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Dhan HQ Broker API (Mode B Data Research & Option Chains)
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here

# ==============================================================================
# Supabase Cloud Database (PostgreSQL & Dual-Write Persistence)
# ==============================================================================
# In Supabase Project Settings -> API:
SUPABASE_URL=https://your-project-id.supabase.co
# Use Service Role Key for backend/cloud, or Anon Key
SUPABASE_KEY=your_supabase_service_role_or_anon_key

# ==============================================================================
# Telegram Notifications & 15-Minute Auto-Execution Alerts
# ==============================================================================
# Bot Token obtained from @BotFather on Telegram (e.g. 7123456789:AAHk...)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Chat ID / Channel ID from @userinfobot (e.g. 123456789 or -100...)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ==============================================================================
# Cloud Deployment (Render / Docker)
# ==============================================================================
# Port dynamically injected by Render ($PORT)
PORT=8080
# Host address (0.0.0.0 on Render/Docker, 127.0.0.1 locally)
HOST=0.0.0.0
# Set to 'true' in Render to suppress auto browser launch
RENDER=false
